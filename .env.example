# Copy to `.env` and fill in. `.env` and `.env.*` are gitignored (see .gitignore);
# only this example file is tracked. Nothing loads `.env` automatically — source it
# yourself (`set -a; . ./.env; set +a`) or set the values in your shell.
#
# In production these are Fly secrets, not a file:
#
#     fly secrets set SECRET_KEY_BASE=... RESEND_API_KEY=... MAIL_FROM=...

# --- required in production ---------------------------------------------------------
# The app RAISES at boot without this one. Generate with `mix phx.gen.secret`.
SECRET_KEY_BASE=

# --- mail (optional; the app boots and works without it) -----------------------------
# Resend API key (D-039). When unset, Consensus.Mailer falls back to
# Swoosh.Adapters.Logger: deliveries "succeed" and log their recipient, but nothing
# reaches an inbox, and runtime.exs warns at boot saying so. Registration is unaffected
# either way — it takes a password and signs the new account in immediately.
RESEND_API_KEY=

# The From address. Resend rejects a domain you have not verified in its dashboard.
# Leave unset to use Resend's `onboarding@resend.dev`, the one sender any account may
# use without verifying a domain.
MAIL_FROM=
MAIL_FROM_NAME=Consensus

# --- overrides you will not normally need --------------------------------------------
# SQLite connection count. Defaults to 1, deliberately — see D-038. One connection
# measured a p95 of 10.6ms on a 15-voter deadline burst where 5 measured 25,762ms and
# lost ballots outright. Raise this only with a measurement in hand.
# POOL_SIZE=1

# Where the SQLite file lives. Set by fly.toml in production; must sit inside the
# mounted volume or the database is silently recreated empty on every deploy.
# DATABASE_PATH=/data/consensus.db
