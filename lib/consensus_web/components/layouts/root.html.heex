<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#DDF0E2" />
    <.live_title default="Consensus" suffix=" · Consensus" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/images/icon.svg"} type="image/svg+xml" />
    <%!-- Instrument Sans carries every surface; DM Mono carries time, counts, urls and the
          uppercase section labels. Both are named in docs/design/DESIGN-SPEC.md and the
          family names have to match what assets/css/app.css asks for. --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-canvas text-ink">
    <%!-- The global chrome is not here either — it is `ConsensusWeb.Chrome.header/1` and
          `footer/1`, rendered by `Layouts.app/1` *inside* the app column (D-041). This
          skeleton stays the document, nothing more: the chrome has to sit inside the
          centred 440px column, and a header emitted here would span the whole viewport
          on a desktop instead. --%>
    {@inner_content}
  </body>
</html>
