# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
consensus-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Python bytecode — docs/design/extract_screens.py leaves a __pycache__ beside itself
# every time the design doc is re-imported.
__pycache__/
*.pyc

# Database files
*.db
*.db-*


# Environment — never commit secrets or API keys
.env
.env.*
!.env.example

# macOS
.DS_Store

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/

# Build-loop scratch: per-iteration design screenshots, side-by-side comparison
# renders and one-off seed/probe scripts. Large binaries with no reader after the
# iteration that produced them — the feature's conclusions belong in docs/, and
# D-051 and D-052 both shipped with their loop/ directories left untracked.
/loop/

# Elixir language server / editor tooling caches
/.elixir_ls/
/.elixir-tools/
/.lexical/
